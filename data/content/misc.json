        { "num": 16, "content": "            Severity: classifySeverity(score),", "type": "code" },
        { "num": 17, "content": "            SHAP:     explanation,", "type": "highlight" },
        { "num": 18, "content": "        }", "type": "code" },
        { "num": 19, "content": "    }", "type": "code" },
        { "num": 20, "content": "}", "type": "code" }
