# Portfolio Admin Panel Environment Variables
# Copy this file to .env.local and fill in your values

# Admin password for the /admin panel
PORTFOLIO_ADMIN_PASSWORD=your-secure-password-here

# JWT secret for signing admin tokens (use a long random string)
JWT_SECRET=your-jwt-secret-change-this-to-something-random

# Optional: Set to 'production' for VPS deployment
NODE_ENV=development
